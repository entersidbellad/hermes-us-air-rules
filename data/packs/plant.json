                "field": "results.70",
                "op": "eq",
                "value": "applies"
              },
              {
                "field": "facility.uses_control_devices",
                "op": "is_true"
              }
            ]
          },
          "verdict": "check_with_ehs",
          "why": "Title V source with control devices: CAM applies per pollutant per unit whose pre-control potential emissions reach the major-source level (§ 64.2(a)), minus the exemptions in § 64.2(b)."
        }
      ],
      "default": {
        "verdict": "check_with_ehs",
        "why": "Title V status is unsettled, so CAM is too."
