          "why": "The facility already holds a title V permit."
        },
        {
          "when": {
            "field": "results.63-LLL",
            "op": "eq",
            "value": "applies"
          },
          "verdict": "applies",
          "why": "Sources subject to subpart LLL are also subject to title V permitting (§ 63.1340(d))."
        },
        {
          "when": {
            "field": "results.63-EEE",
            "op": "eq",
            "value": "applies"
          },
          "verdict": "applies",
          "why": "Hazardous waste combustors are subject to title V (§ 63.1200(a)(2)-(3))."
        },
        {
          "when": {
            "field": "facility.major_hap",
            "op": "is_true"
          },
          "verdict": "applies",
          "why": "Major source of HAP (§ 70.3(a)(1))."
        },
        {
          "when": {
            "field": "facility.criteria_pte_major",
            "op": "is_true"
          },
          "verdict": "applies",
