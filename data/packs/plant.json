        "applicability": "64.2"
      },
      "fr": {
        "part": "64",
        "term": "\"compliance assurance monitoring\""
      },
      "scope": "facility",
      "rules": [
        {
          "when": {
            "field": "results.70",
            "op": "eq",
            "value": "skip"
          },
          "verdict": "skip",
          "why": "CAM applies only at sources required to hold a title V permit."
        },
        {
          "when": {
            "field": "facility.uses_control_devices",
            "op": "is_false"
          },
          "verdict": "skip",
          "why": "CAM applies only to units that use a control device to meet a limit (§ 64.2(a)(2))."
        },
        {
          "when": {
            "all": [
